<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: every 3 hours so "today" rolls over even if the app
     isn't opened (the app also refreshes it whenever data changes). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:description="@string/widget_today_desc"
    android:widgetCategory="home_screen" />
