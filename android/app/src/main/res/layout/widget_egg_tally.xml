<?xml version="1.0" encoding="utf-8"?>
<!-- Egg Counter widget (EggTallyWidget.java). Header opens the app; the
     buttons add to the flock's tally without opening it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/tally_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tally_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2C1810"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="🐔 Flock" />

        <TextView
            android:id="@+id/tally_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#2C1810"
            android:text="0" />

        <TextView
            android:id="@+id/tally_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#5C4530"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="eggs today" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tally_minus"
            style="@style/HenTallyButton"
            android:layout_marginEnd="6dp"
            android:text="−" />

        <TextView
            android:id="@+id/tally_plus"
            style="@style/HenTallyButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_yolk_bg"
            android:text="+" />

        <TextView
            android:id="@+id/tally_plus6"
            style="@style/HenTallyButton"
            android:text="+6" />
    </LinearLayout>
</LinearLayout>
